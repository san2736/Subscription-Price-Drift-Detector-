{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsoleListAndRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetAccountPublicAccessBlock",
        "lambda:ListFunctions",
        "lambda:ListLayers",
        "lambda:ListLayerVersions",
        "lambda:GetAccountSettings",
        "lambda:ListEventSourceMappings",
        "dynamodb:ListTables",
        "dynamodb:DescribeLimits",
        "dynamodb:DescribeEndpoints",
        "sns:ListTopics",
        "sns:ListSubscriptions",
        "events:ListRules",
        "events:ListEventBuses",
        "events:DescribeEventBus",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:StopQuery",
        "logs:DescribeQueries",
        "logs:StartLiveTail",
        "logs:StopLiveTail",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "iam:ListRoles",
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "kms:ListAliases",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ecr:GetAuthorizationToken",
        "ecr:DescribeRepositories",
        "athena:ListWorkGroups",
        "athena:ListDataCatalogs",
        "athena:ListDatabases",
        "athena:ListEngineVersions",
        "athena:ListTableMetadata",
        "athena:GetTableMetadata",
        "athena:GetDatabase",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartitions",
        "glue:SearchTables",
        "states:ListStateMachines",
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "budgets:ViewBudget",
        "iam:ListVirtualMFADevices",
        "iam:GetAccountPasswordPolicy",
        "iam:GetAccountSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudShell",
      "Effect": "Allow",
      "Action": "cloudshell:*",
      "Resource": "*"
    },
    {
      "Sid": "ProjectBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::pdd-*",
        "arn:aws:s3:::pdd-*/*"
      ]
    },
    {
      "Sid": "ProtectBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::pdd-*"
    },
    {
      "Sid": "ProjectLambdas",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:ap-south-1:778799435243:function:pdd-*",
        "arn:aws:lambda:ap-south-1:778799435243:layer:pdd-*",
        "arn:aws:lambda:ap-south-1:778799435243:layer:pdd-*:*"
      ]
    },
    {
      "Sid": "PassLambdaRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::778799435243:role/pdd-lambda-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassStepFunctionsRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::778799435243:role/pdd-sfn-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "states.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ProjectTables",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:778799435243:table/pdd-*",
        "arn:aws:dynamodb:ap-south-1:778799435243:table/pdd-*/*"
      ]
    },
    {
      "Sid": "ProjectTopics",
      "Effect": "Allow",
      "Action": "sns:*",
      "Resource": "arn:aws:sns:ap-south-1:778799435243:pdd-*"
    },
    {
      "Sid": "ProjectRules",
      "Effect": "Allow",
      "Action": "events:*",
      "Resource": "arn:aws:events:ap-south-1:778799435243:rule/pdd-*"
    },
    {
      "Sid": "ProjectLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy"
      ],
      "Resource": "arn:aws:logs:ap-south-1:778799435243:log-group:/aws/lambda/pdd-*"
    },
    {
      "Sid": "ProjectContainerImages",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:ap-south-1:778799435243:repository/pdd-*"
    },
    {
      "Sid": "ProjectAthena",
      "Effect": "Allow",
      "Action": "athena:*",
      "Resource": [
        "arn:aws:athena:ap-south-1:778799435243:workgroup/pdd-*",
        "arn:aws:athena:ap-south-1:778799435243:datacatalog/AwsDataCatalog"
      ]
    },
    {
      "Sid": "ProjectGlueCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:CreateDatabase",
        "glue:UpdateDatabase",
        "glue:DeleteDatabase",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition",
        "glue:BatchGetPartition",
        "glue:GetPartition"
      ],
      "Resource": [
        "arn:aws:glue:ap-south-1:778799435243:catalog",
        "arn:aws:glue:ap-south-1:778799435243:database/pdd_*",
        "arn:aws:glue:ap-south-1:778799435243:table/pdd_*/*"
      ]
    },
    {
      "Sid": "ProjectStateMachines",
      "Effect": "Allow",
      "Action": "states:*",
      "Resource": [
        "arn:aws:states:ap-south-1:778799435243:stateMachine:pdd-*",
        "arn:aws:states:ap-south-1:778799435243:execution:pdd-*:*"
      ]
    },
    {
      "Sid": "ManageOwnCredentials",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ChangePassword",
        "iam:GetLoginProfile",
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:ListAccessKeys",
        "iam:UpdateAccessKey",
        "iam:GetAccessKeyLastUsed",
        "iam:ListMFADevices",
        "iam:EnableMFADevice",
        "iam:ResyncMFADevice",
        "iam:DeactivateMFADevice"
      ],
      "Resource": "arn:aws:iam::778799435243:user/${aws:username}"
    },
    {
      "Sid": "ManageOwnMFADevice",
      "Effect": "Allow",
      "Action": [
        "iam:CreateVirtualMFADevice",
        "iam:DeleteVirtualMFADevice"
      ],
      "Resource": "arn:aws:iam::778799435243:mfa/*"
    }
  ]
}
